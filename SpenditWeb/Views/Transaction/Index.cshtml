@model IEnumerable<Spendit.Models.Transaction>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


@{
    List<object> cols = new List<object>();
    cols.Add(new { field = "Date", direction = "Descending" });
    ViewData["Title"] = "Index";
    IEnumerable<Category> categories = ViewBag.Categories;
    int? selectedCategoryId = ViewBag.CategoryId;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<p>
    <div>
        <a class="btn btn-danger" href="Transaction/Create">
            <i class="bi bi-plus-lg"></i> New Transaction
        </a>
    </div>
</p>

<form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label for="from" class="form-label">From</label>
        <input id="from" name="from" type="date" value="@ViewBag.From" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="to" class="form-label">To</label>
        <input id="to" name="to" type="date" value="@ViewBag.To" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="categoryId" class="form-label">Category</label>
        <select id="categoryId" name="categoryId" class="form-select">
            @foreach (Category category in categories)
            {
                if (category.CategoryId == selectedCategoryId)
                {
                    <option value="@category.CategoryId" selected>@category.TitleWithIcon</option>
                }
                else
                {
                    <option value="@category.CategoryId">@category.TitleWithIcon</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Any())
{
    <div class="row">
        <div class="col-md-12">
            <ejs-grid id="transactions" dataSource="@Model" gridLines="None"
                      allowSorting="true" toolbar="@(new List<string>() { "Search"})">
                <e-grid-sortsettings columns="cols"></e-grid-sortsettings>
                <e-grid-columns>
                    <e-grid-column headerText="Category" field="CategoryTitleWithIcon" textAlign="Justify" width="200px"></e-grid-column>
                    <e-grid-column headerText="Type" template="#typeColumnTemplate" textAlign="Center" width="100px"></e-grid-column>
                    <e-grid-column headerText="Date" field="Date" type="date" format="MMM-dd-yy" textAlign="Center" width="100px"></e-grid-column>
                    <e-grid-column headerText="Amount" template="#amountColumnTemplate" textAlign="Center" width="100px"></e-grid-column>
                    <e-grid-column headerText="Actions" template="#actionColumnTemplate" textAlign="Center" width="100px"></e-grid-column>
                    @* for searching purpose *@
                    <e-grid-column field="Amount" visible=false></e-grid-column>
                    <e-grid-column field="Category.Type" visible=false></e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center" role="status">
        No transactions found. Try adjusting your filters or add a new transaction.
    </div>
}

@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Transaction pages">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To"
                   asp-route-categoryId="@ViewBag.CategoryId"
                   asp-route-page="@(currentPage - 1)">Previous</a>
            </li>
            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == currentPage ? "active" : null)">
                    <a class="page-link" asp-action="Index"
                       asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To"
                       asp-route-categoryId="@ViewBag.CategoryId"
                       asp-route-page="@pageNumber">@pageNumber</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To"
                   asp-route-categoryId="@ViewBag.CategoryId"
                   asp-route-page="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

<script id="amountColumnTemplate" type="text/x-template">
    ${if(Category.Type=="@CategoryType.Income")}
        <span class="badge bg-info">${FormattedAmount}</span>
    ${else}
        <span class="badge bg-danger">${FormattedAmount}</span>
    ${/if}
</script>

<script id="typeColumnTemplate" type="text/x-template">
    ${if(Category.Type=="@CategoryType.Income")}
        <span class="badge bg-info">${Category.Type}</span>
    ${else}
        <span class="badge bg-danger">${Category.Type}</span>
    ${/if}
</script>

<script id="actionColumnTemplate" type="text/x-template">
       <div class="d-flex justify-content-center">
        <div class="btn-group" role="group">
            <a href="/Transaction/Edit/${TransactionId}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil-fill"></i>
            </a>
            <a href="/Transaction/Details/${TransactionId}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-info-lg"></i>
            </a>
            <a href="/Transaction/Delete/${TransactionId}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-trash3-fill"></i>
            </a>
        </div>
    </div>
</script>
